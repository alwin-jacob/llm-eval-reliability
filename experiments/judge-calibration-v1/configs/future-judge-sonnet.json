{
  "schema_version": "1",
  "dataset": "../dataset/v1",
  "candidate": {
    "type": "run_artifact",
    "run_file": "../artifacts/candidate-haiku.run.json"
  },
  "scorers": [
    {
      "type": "judge",
      "name": "sonnet_instruction_judge",
      "rubric": "Apply the per-example expected.rubric exactly. Pass only when every stated requirement is satisfied. Treat deterministic expectations as supporting evidence and do not assume an unlabeled human verdict.",
      "pass_threshold": 0.5,
      "seed": null,
      "exclude_expected_keys": ["human_reference_label", "human_reference_status"],
      "candidate": {
        "type": "claude_cli",
        "model": "sonnet",
        "system_prompt": "You are an evaluation judge. Apply the supplied rubric and return only the requested JSON.",
        "timeout_seconds": 120.0,
        "max_turns": 1,
        "executable": "claude"
      },
      "invocation": {
        "timeout_seconds": 125.0,
        "max_attempts": 1,
        "initial_backoff_seconds": 0.0,
        "max_backoff_seconds": 0.0,
        "jitter_ratio": 0.0
      }
    }
  ],
  "evaluation": {
    "concurrency": 1,
    "scorer_timeout_seconds": 130.0,
    "seed": null,
    "candidate_invocation": {
      "timeout_seconds": 5.0,
      "max_attempts": 1,
      "initial_backoff_seconds": 0.0,
      "max_backoff_seconds": 0.0,
      "jitter_ratio": 0.0
    }
  }
}
