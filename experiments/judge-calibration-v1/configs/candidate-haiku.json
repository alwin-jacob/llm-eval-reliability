{
  "schema_version": "1",
  "dataset": "../dataset/v1",
  "candidate": {
    "type": "claude_cli",
    "model": "haiku",
    "system_prompt": "You are a model under evaluation. Answer only the user request.",
    "timeout_seconds": 120.0,
    "max_turns": 1,
    "executable": "claude"
  },
  "scorers": [
    {"type": "json_schema"},
    {"type": "json_fields"},
    {
      "type": "exact_match",
      "name": "exact_constraints",
      "expected_key": "exact_text",
      "strip": false,
      "case_sensitive": true,
      "collapse_whitespace": false
    },
    {"type": "text_constraints"}
  ],
  "evaluation": {
    "concurrency": 2,
    "scorer_timeout_seconds": 5.0,
    "seed": null,
    "candidate_invocation": {
      "timeout_seconds": 125.0,
      "max_attempts": 1,
      "initial_backoff_seconds": 0.0,
      "max_backoff_seconds": 0.0,
      "jitter_ratio": 0.0
    }
  }
}
